// niri watches this file through the store symlink and live-reloads it on change.

input {
    keyboard {
        xkb {
            // Binds resolve against the first layout, and digits need no shift on `pl`.
            layout "pl"
        }
    }

    mouse {
        accel-profile "flat"
        accel-speed -0.5
    }
    // With max-scroll-amount="0%" a partly-visible column would stop focusing on hover; no
    // `warp-mouse-to-focus`, so the pointer never jumps to a window.
    focus-follows-mouse

    workspace-auto-back-and-forth
}

// Two 1440p panels at scale 1, DP-2 to the left of DP-1.
// A mode without a refresh rate takes the highest one available, which is 144 Hz on DP-1
// and 75 Hz on DP-2 (its preferred mode is 60 Hz).
output "DP-1" {
    mode "2560x1440"
    position x=0 y=0
}

output "DP-2" {
    mode "2560x1440"
    position x=-2560 y=0
}

layout {
    // gaps apply inside and outside, struts only outside: 4 px between windows, 8 px at the edges.
    gaps 4

    struts {
        left 4
        right 4
        top 4
        bottom 4
    }

    // niri's default is half the screen; 1.0 lets a lone window fill the output.
    default-column-width { proportion 1.0; }

    // The border alone marks the active window; a focus ring would draw a second line.
    focus-ring {
        off
    }

    border {
        width 1
    }

    // swaybg plays the wallpaper on the background layer (home-manager/swaybg.nix), so niri must
    // not paint an opaque workspace over it.
    background-color "transparent"
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

// Noctalia's surfaces are translucent, so they need the compositor to blur what is behind them.
window-rule {
    background-effect { blur true; xray false; }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect { xray false; }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect { blur true; xray false; }
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Notification actions and activating windows from the launcher send a serial niri rejects.
debug {
    honor-xdg-activation-with-invalid-serial
}

hotkey-overlay {
    skip-at-startup
}

// Mod is Super in a session on a TTY; dragging to move and resize are niri built-ins.
binds {
    // hotkey-overlay-title is what the Super+Shift+/ cheat sheet shows; null hides a bind there.
    Mod+Return hotkey-overlay-title="Terminal" { spawn "wezterm"; }
    Mod+Space allow-when-locked=true hotkey-overlay-title="Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+E hotkey-overlay-title="File Manager" { spawn "thunar"; }
    Mod+S allow-when-locked=true hotkey-overlay-title="Control Centre" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Shift+V allow-when-locked=true hotkey-overlay-title="Clipboard History" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Tab allow-when-locked=true hotkey-overlay-title="Window Switcher" { spawn-sh "noctalia msg window-switcher"; }
    Mod+Comma hotkey-overlay-title="Noctalia Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+L allow-when-locked=true hotkey-overlay-title="Lock Screen" { spawn-sh "noctalia msg session lock"; }
    // niri runs as a systemd session, so `quit` ends it.
    Mod+Shift+E { quit; }

    Mod+Q { close-window; }
    Mod+V { toggle-window-floating; }
    // SUPER+SHIFT+V is the clipboard, so the floating layer switch takes T.
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+M { maximize-window-to-edges; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+C hotkey-overlay-title="Centre Column" { center-column; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left hotkey-overlay-title="Move Column to Left Monitor" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right hotkey-overlay-title="Move Column to Right Monitor" { move-column-to-monitor-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // The cooldown stops a fast spin flying past the workspace you want.
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    // Escape hatch: an app that grabs all shortcuts cannot hold the session hostage.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // allow-when-locked: these keys must reach the shell on the lock screen.
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg media previous"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title=null { spawn-sh "noctalia msg brightness-down"; }

    Print hotkey-overlay-title="Screenshot: Region" { spawn-sh "noctalia msg screenshot-region"; }
    Shift+Print hotkey-overlay-title="Screenshot: Monitor" { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Ctrl+Print hotkey-overlay-title="Screenshot: Pick Monitor" { spawn-sh "noctalia msg screenshot-fullscreen pick"; }

    Mod+Ctrl+P hotkey-overlay-title="Pick Colour" { spawn-sh "hyprpicker -a"; }

    // Any input wakes the monitors again.
    Mod+Shift+P { power-off-monitors; }
}

// Noctalia's `niri` template writes the palette to ~/.config/niri/noctalia.kdl and appends this
// include to the config before wiring it up, so it has to be here even though the store file is
// read-only. Relative, so it follows $XDG_CONFIG_HOME; `optional` because the file appears only
// after a theme is applied for the first time.
include optional=true "noctalia.kdl"
