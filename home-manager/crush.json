{
  "$schema": "https://charm.land/crush.json",
  "lsp": {
    "rust": {
      "command": "rust-analyzer",
      "filetypes": [
        "rs"
      ],
      "root_markers": [
        "Cargo.toml",
        ".git"
      ]
    },
    "ruff": {
      "command": "ruff",
      "args": [
        "server"
      ],
      "filetypes": [
        "py"
      ],
      "root_markers": [
        "pyproject.toml",
        "ruff.toml",
        ".ruff.toml",
        ".git"
      ]
    },
    "clangd": {
      "command": "clangd",
      "filetypes": [
        "c",
        "cpp",
        "objc",
        "objcpp",
        "cuda"
      ],
      "root_markers": [
        ".clangd",
        ".clang-tidy",
        ".clang-format",
        "compile_commands.json",
        "compile_flags.txt",
        "configure.ac",
        ".git"
      ]
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "filetypes": [
        "ts"
      ],
      "root_markers": [
        "tsconfig.json"
      ]
    },
    "nix": {
      "command": "nil",
      "filetypes": [
        "nix"
      ],
      "root_markers": [
        "flake.nix"
      ]
    }
  },
  "mcp": {
    "searxng": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "https://search.steelph0enix.dev/"
      }
    }
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "curl",
      "wget"
    ]
  },
  "options": {
    "disabled_tools": [],
    "disable_metrics": true,
    "disable_provider_auto_update": true,
    "disable_default_providers": true,
    "auto_lsp": true,
    "progress": true,
    "tui": {
      "completions": {
        "max_depth": 3,
        "max_items": 100
      },
      "compact_mode": true,
      "diff_mode": "unified"
    },
    "initialize_as": "AGENTS.md",
    "attribution": {
      "trailer_style": "assisted-by",
      "generated_with": true
    }
  },
  "tools": {
    "ls": {
      "max_depth": 3,
      "max_items": 100
    }
  },
  "providers": {
    "llama-cpp": {
      "id": "llama-cpp",
      "name": "llama.cpp",
      "base_url": "http://192.168.0.185:51536/v1/",
      "type": "openai-compat",
      "system_prompt_prefix": "You are an expert AI coding assistant running locally, with full access to the project's environment.",
      "models": [
        {
          "name": "Qwen3-Coder-30B",
          "id": "Qwen3-Coder-30B",
          "context_window": 262144,
          "default_max_tokens": 65536,
          "can_reason": false,
          "supports_attachments": false,
          "cost_per_1m_in": 0,
          "cost_per_1m_in_cached": 0,
          "cost_per_1m_out": 0,
          "cost_per_1m_out_cached": 0,
          "options": {
            "temperature": 0.7,
            "top_k": 20,
            "top_p": 0.8
          }
        },
        {
          "name": "gpt-oss-120B",
          "id": "gpt-oss-120B",
          "context_window": 131072,
          "default_max_tokens": 65536,
          "can_reason": true,
          "default_reasoning_effort": "high",
          "supports_attachments": false,
          "cost_per_1m_in": 0,
          "cost_per_1m_in_cached": 0,
          "cost_per_1m_out": 0,
          "cost_per_1m_out_cached": 0,
          "options": {
            "temperature": 1.0,
            "top_k": 100,
            "top_p": 1.0,
            "provider_options": {
              "min_p": 0.01
            }
          }
        },
        {
          "name": "GLM 4.5 Air",
          "id": "GLM-4.5-Air",
          "context_window": 131072,
          "default_max_tokens": 65536,
          "can_reason": true,
          "supports_attachments": false,
          "cost_per_1m_in": 0,
          "cost_per_1m_in_cached": 0,
          "cost_per_1m_out": 0,
          "cost_per_1m_out_cached": 0,
          "options": {
            "temperature": 0.6,
            "top_p": 1.0
          }
        },
        {
          "name": "GLM 4.7 Flash",
          "id": "GLM-4.7-Flash",
          "context_window": 202752,
          "default_max_tokens": 65536,
          "can_reason": true,
          "supports_attachments": false,
          "cost_per_1m_in": 0,
          "cost_per_1m_in_cached": 0,
          "cost_per_1m_out": 0,
          "cost_per_1m_out_cached": 0,
          "options": {
            "temperature": 0.7,
            "top_p": 1.0,
            "provider_options": {
              "min_p": 0.01,
              "repeat_penalty": 1.0
            }
          }
        },
        {
          "name": "Qwen3 Next",
          "id": "Qwen3-Next",
          "context_window": 262144,
          "default_max_tokens": 65536,
          "can_reason": false,
          "supports_attachments": false,
          "cost_per_1m_in": 0,
          "cost_per_1m_in_cached": 0,
          "cost_per_1m_out": 0,
          "cost_per_1m_out_cached": 0,
          "options": {
            "temperature": 0.7,
            "top_k": 20,
            "top_p": 0.8,
            "provider_options": {
              "min_p": 0.01
            }
          }
        }
      ]
    }
  }
}
